# Final required runtime config (CP5+CP6 merged workflow)

# LLM provider for merged workflow: openai or azure_openai
MODEL_PROVIDER=openai

# OpenAI path (recommended)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Azure OpenAI path (optional fallback)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=

# App/profile runtime defaults
N8N_WEBHOOK_BASE=http://n8n:5678/webhook
DEFAULT_PROFILE_ID=custom_profile_starter
