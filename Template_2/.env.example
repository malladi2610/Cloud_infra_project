# Core runtime
APP_PORT=8080
NODE_ENV=development

# Postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=template2
DB_USER=template2
DB_PASSWORD=template2
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Sessions and internal auth
# Generate secure random values for these in production, e.g. using `openssl rand -hex 32`
SESSION_SECRET=change_me_session_secret
INTERNAL_API_TOKEN=change_me_internal_token

# n8n integration
N8N_WEBHOOK_BASE=http://n8n:5678/webhook
N8N_RUN_WEBHOOK_URL=http://n8n:5678/webhook/summaries/run
N8N_BENCHMARK_WEBHOOK_URL=http://n8n:5678/webhook/benchmarks/run
N8N_REQUEST_TIMEOUT_MS=10000
APP_INTERNAL_BASE_URL=http://app:8080

# Execution controls (n8n-only)
DEFAULT_PROFILE_ID=pdf_batch_summary

# OpenAI settings (used by n8n workflows; app uses model/pricing for result metadata + cost estimation fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FILE_UPLOAD_MAX_RETRIES=3
OPENAI_FILE_UPLOAD_RETRY_BASE_MS=750
OPENAI_BATCH_COMPLETION_WINDOW=24h
OPENAI_INPUT_TOKEN_PRICE_PER_MILLION_USD=0.15
OPENAI_OUTPUT_TOKEN_PRICE_PER_MILLION_USD=0.60
# Optional: set explicit batch prices directly from OpenAI pricing page.
# If omitted, batch prices fall back to sync prices.
OPENAI_BATCH_INPUT_TOKEN_PRICE_PER_MILLION_USD=0.075
OPENAI_BATCH_OUTPUT_TOKEN_PRICE_PER_MILLION_USD=0.30
BENCHMARK_REPETITIONS=3
BENCHMARK_JOBS_PER_RUN=20
# n8n task-runner timeout is in seconds (default n8n is 300). Keep above (BATCH_POLLER_INTERVAL_MS * BATCH_POLLER_MAX_LOOPS) / 1000.
N8N_RUNNERS_TASK_TIMEOUT=1200
N8N_RUNNERS_MAX_OLD_SPACE_SIZE=512
BATCH_POLLER_INTERVAL_MS=20000
BATCH_POLLER_MAX_LOOPS=45
BENCHMARK_BATCH_POLL_INTERVAL_MS=20000
BENCHMARK_BATCH_MAX_WAIT_MS=7200000

# Batch strategy defaults
MAX_BATCH_SIZE=20
MAX_WAIT_SECONDS=60
BATCH_POLLER_INTERVAL_SEC=20

# File storage
BLOB_PROVIDER=local
LOCAL_BLOB_DIR=/workspace/storage/documents
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=template2-documents
PDF_RETENTION_DAYS=30
MAX_UPLOAD_MB=25

# Bootstrap admin user (optional)
ADMIN_EMAIL=admin@template2.local
ADMIN_PASSWORD=ChangeMe123!
